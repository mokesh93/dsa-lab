class node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None


class doublylinkedlist:
    def __init__(self):
        self.head = None

    # Insert at the end
    def insert(self, data):
        n = node(data)

        if self.head is None:
            self.head = n
        else:
            temp = self.head

            while temp.next is not None:
                temp = temp.next

            temp.next = n
            n.prev = temp

    # Display from beginning to end
    def display(self):
        temp = self.head

        while temp is not None:
            print(temp.data, end=" <-> ")
            temp = temp.next

        print("None")

    # Delete a node
    def delete(self, data):
        temp = self.head

        while temp is not None:

            if temp.data == data:

                # If deleting the first node
                if temp.prev is None:
                    self.head = temp.next

                    if self.head is not None:
                        self.head.prev = None

                # If deleting middle or last node
                else:
                    temp.prev.next = temp.next

                    if temp.next is not None:
                        temp.next.prev = temp.prev

                return

            temp = temp.next

        print("Node not found")


# Create linked list
l = doublylinkedlist()

# Insert nodes
l.insert(10)
l.insert(20)
l.insert(30)
l.insert(40)

# Display
print("Original list:")
l.display()

# Delete node
l.delete(20)

print("After deleting 20:")
l.display()
