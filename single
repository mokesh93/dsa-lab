class node:
    def __init__(self,name,age):
        self.name=name
        self.age=age
        self.next=None


class nodelist:
    def __init__(self):
        self.head=None

    def insert(self):
        name=input("enter the name:")
        age=int(input("entert the age"))
        n=node(name,age)

        if self.head is None:
            self.head=n
        else:
            temp=self.head

            while temp.next is not None:
                temp=temp.next

            temp.next=n

    def display(self):
        if self.head is None:
            print("not found")
            return

        temp=self.head

        while temp is not None:
            print("name:",temp.name)
            print("age:",temp.age)
            print("*"*10)
            temp=temp.next
                
    def search(self):
        if self.head is None:
            print("not found")
            return

        temp=self.head

        while temp is not None:
            v=int(input("enter the age:"))
            if temp.age<=v:
                print("name:",temp.name)
                print("age:",temp.age)
                print("*"*10)
                temp=temp.next

